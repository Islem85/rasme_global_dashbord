# ── Streamlit secrets — DEMO deployment ───────────────────────────────────────
# Copy this file to `.streamlit/secrets.toml` for local runs, OR paste these
# keys into the "Secrets" box of your Streamlit Community Cloud app.
#
# Use FLAT keys (no [sections]) — db.py mirrors scalar secrets into environment
# variables so engine() can read them with os.getenv().
#
# These point the dashboard at the SYNTHETIC demo database (see demo/seed_demo_db.py).
# Never put the internal AfDB database credentials in a public deployment.

PG_HOST = "ep-xxxxxx-pooler.eu-central-1.aws.neon.tech"   # your demo Postgres host
PG_PORT = "5432"
PG_DB   = "neondb"
PG_USER = "neondb_owner"
PG_PASSWORD = "your-demo-db-password"
PG_SSLMODE = "require"        # Neon / most managed Postgres require SSL

CACHE_TTL_SECONDS = "300"

# KOBO_* are intentionally omitted for the demo: the synthetic photo URLs are
# public, so no Kobo credentials are needed. Leave them unset.
